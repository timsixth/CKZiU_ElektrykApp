<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="2dp"
    app:cardElevation="4dp"
    app:strokeColor="#1AFFFFFF"
    app:strokeWidth="1dp"
    card_view:cardBackgroundColor="#202020"
    card_view:cardCornerRadius="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="76dp"
        android:paddingStart="0dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <!-- LessonNumber -->
        <TextView
            android:id="@+id/textViewLessonNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/lessonCard_placeholder_lessonNumber"
            android:textAlignment="center"
            android:textColor="@color/fontColor"
            android:textSize="26sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/lessonCard_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Merged Lesson Number Container -->
        <LinearLayout
            android:id="@+id/layout_mergedLessonNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/lessonCard_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textViewLessonNumberStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/fontColor"
                android:textSize="26sp" />

            <View
                android:id="@+id/view_mergedLessonDivider"
                android:layout_width="1.5dp"
                android:layout_height="10dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:background="#44FFFFFF" />

            <TextView
                android:id="@+id/textViewLessonNumberEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/fontColor"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- LessonHours -->
        <View
            android:id="@+id/lessonCard_divider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginStart="52dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="?android:attr/listDivider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewLessonHours"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:alpha="0.85"
            android:gravity="start"
            android:paddingTop="0dp"
            android:text="@string/lessonCard_placeholder_lessonTimeRange"
            android:textColor="@color/fontColor"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/lessonCard_divider"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Lessons Container -->
        <LinearLayout
            android:id="@+id/layout_lessonsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="2dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/lessonCard_divider"
            app:layout_constraintTop_toBottomOf="@id/textViewLessonHours">

            <TextView
                android:id="@+id/textViewLessonData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:textAlignment="center"
                android:textColor="@color/fontColor"
                android:textSize="18sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
